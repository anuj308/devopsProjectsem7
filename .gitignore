# Secrets and local credentials
.env
.env.*
!.env.example
.aws/
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Terraform working data and local inputs
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
*.tfplan
*.plan
.terraformrc
terraform.rc

# Ansible-generated or local data
ansible/inventory.ini
ansible/*.retry
ansible/.vault_pass
ansible/.ansible/

# Generated evidence that may contain addresses or terminal details
docs/screenshots/private/

# Local report-generation environment (virtualenv, packages, renders and scratch files)
/.office-build/

# Keep only the final submission files; the demo guide is maintained in docs/.
/submission/*
!/submission/LPU_DevOps_Report_Final.docx
!/submission/LPU_DevOps_Report_Final.pdf
!/submission/DevOps_Viva_Final.pptx

# Temporary lock files created while editing Office documents
~$*
.~lock.*#

# Editor and operating-system files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
